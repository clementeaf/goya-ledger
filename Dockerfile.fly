# syntax=docker/dockerfile:1
# Lightweight build for Fly.io seed node — no EVM, no Wasm, no Raft.

ARG CACHE_BUST=1
FROM debian:bookworm AS builder

RUN apt-get update && apt-get install -y \
    curl pkg-config libssl-dev build-essential clang libclang-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain nightly-2026-04-20

ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY tools/ tools/

# Dummy src for dependency pre-build
RUN mkdir src && echo 'fn main() {}' > src/main.rs && echo '' > src/lib.rs

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release --no-default-features --features "rocksdb-storage,evm" 2>/dev/null || true

COPY . .

ARG CACHE_BUST=1
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cargo build --release --no-default-features --features "rocksdb-storage,evm" && cp target/release/rust-bc /usr/local/bin/rust-bc

# ── Runtime ──
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/rust-bc /usr/local/bin/rust-bc

RUN mkdir -p /data/blocks

ENV API_PORT=8080 \
    RUST_LOG=info

EXPOSE 8080

CMD ["rust-bc"]
